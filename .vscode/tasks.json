{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "lint and typecheck",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/c",
				"npm run lint && npx tsc --noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc",
				"$eslint-stylish"
			]
		},
		{
			"label": "install dependencies",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/c",
				"npm install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "typecheck",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/c",
				"npx tsc --noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "dev server",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/c",
				"npm run dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}